rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to fetch the user's role from the users collection
    function getUserRole() {
      // If we had custom claims, we could do: return request.auth.token.role
      // Instead, we securely look up the user's role document
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isEditor() {
      return isAuthenticated() && (getUserRole() == 'editor' || getUserRole() == 'admin');
    }

    // Users Collection (Profile & Role)
    match /users/{userId} {
      // Anyone can read their own profile. Only admins can read/write all.
      allow read: if request.auth.uid == userId || isAdmin();
      // Only admins can change roles. Users cannot escalate their own privileges.
      allow write: if isAdmin();
    }

    // Core Content Collections (Portfolio, Posts, Pages, Testimonials, Team, Services, Blog)
    match /portfolio/{documentId} {
      allow read: if true;
      allow write: if isEditor();
      match /_versions/{versionId} { allow read, write: if isEditor(); }
    }

    match /posts/{documentId} {
      allow read: if true;
      allow write: if isEditor();
      match /_versions/{versionId} { allow read, write: if isEditor(); }
    }



    match /pages/{documentId} {
      allow read: if true;
      allow write: if isEditor();
      match /_versions/{versionId} { allow read, write: if isEditor(); }
    }
    
    match /services/{documentId} {
      allow read: if true;
      allow write: if isEditor();
      match /_versions/{versionId} { allow read, write: if isEditor(); }
    }
    
    match /testimonials/{documentId} {
      allow read: if true;
      allow write: if isEditor();
      match /_versions/{versionId} { allow read, write: if isEditor(); }
    }
    
    match /team/{documentId} {
      allow read: if true;
      allow write: if isEditor();
      match /_versions/{versionId} { allow read, write: if isEditor(); }
    }

    match /faqs/{documentId} {
      allow read: if true;
      allow write: if isEditor();
      match /_versions/{versionId} { allow read, write: if isEditor(); }
    }

    match /process/{documentId} {
      allow read: if true;
      allow write: if isEditor();
      match /_versions/{versionId} { allow read, write: if isEditor(); }
    }

    // Settings Collection
    match /settings/{documentId} {
      allow read: if true;
      allow write: if isAdmin(); 
      match /_versions/{versionId} { allow read, write: if isAdmin(); }
    }

    // Rate Limits Collection (Contact Form)
    match /rate_limits/{ipHash} {
      allow read, write: if true; 
    }
  }
}
